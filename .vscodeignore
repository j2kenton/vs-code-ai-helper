.codex
.agents/**
.claude/**
.git/**
.github/**
.vscode/**
.vscode-test/**
.vscode-test.mjs

src/**
out/**
coverage/**
node_modules/**

# The workspace packages and the mobile/web app. NONE of this belongs in the
# extension: esbuild bundles src/extension.ts with `vscode` as the only
# external, and nothing under src/ imports these packages, so the shipped
# dist/extension.js does not reference a byte of it.
#
# Without these lines 671 files shipped, including
# packages/ensemble-control-plane/.env.local (the KEK boot secret plus BOTH
# OAuth client secrets) and control-plane.sqlite (session records and
# encrypted key envelopes). .gitignore does NOT protect against this — vsce
# ignores .gitignore entirely whenever a .vscodeignore exists, which is the
# same trap documented for .ensemble/ below.
apps/**
packages/**

# Defence in depth for the two file classes above, so a new package or a
# relocated app cannot reintroduce the leak by sitting outside those globs.
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-journal
**/*.db

# Task meta folders. These hold run logs, which contain full AI prompts and
# context packs (verbatim source excerpts, absolute local paths) — the same
# content commitAndPushTask deliberately excludes from commits and DISCLAIMER.md
# flags as sensitive. `plans/` is the pre-0.53.0 name, kept so an older or
# custom-configured task root stays excluded too.
#
# NOTE: vsce ignores .gitignore entirely whenever a .vscodeignore exists, so
# .gitignore offers NO protection here. If DEFAULT_TASK_ROOT in
# src/utils/taskRoot.ts is ever renamed again, this list must be updated in the
# same change or private data ships to the marketplace silently.
.ensemble/**
plans/**

# Author working material — not user documentation.
notes/**
docs/**
plan-final.md

# Test and build tooling.
test-stubs/**
test-fixtures/**
dist/test/**
dist/test-host/**
tsconfig.test.json
tsconfig.vscode-1.93-compat.json
scripts/**
workflow-inventories/**
.pnpm-store/**

.eslintrc.json
.gitignore
tsconfig.json
esbuild.js
esbuild.config.js
pnpm-lock.yaml
package-lock.json
pnpm-workspace.yaml
yarn.lock

*.vsix
dist/**/*.map
dist/meta.json

# Local run output. Untracked, so .gitignore never had to cover it — but vsce
# does not read .gitignore, so these shipped: three stray suite logs totalling
# ~850KB of local absolute paths and test names.
*.log
