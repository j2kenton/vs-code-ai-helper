        "vs-code-ai-helper.fastForwardMaxIterations": {
          "deprecationMessage": "Use `ensemble.fastForwardMaxIterations` instead.",
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 99,
          "scope": "window",
          "description": "Maximum fast-forward iterations (1–99)."
        },
        "vs-code-ai-helper.autoAdvanceEnabled": {
          "deprecationMessage": "Use `ensemble.autoAdvanceEnabled` instead.",
          "type": [
            "string",
            "boolean"
          ],
          "enum": [
            "off",
            "auto",
            "auto-fast-forward",
            false,
            true
          ],
          "enumDescriptions": [
