  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:unit": "node -e \"require('fs').rmSync('out/test',{recursive:true,force:true})\" && tsc --project tsconfig.test.json && node test-stubs/run-unit-tests.js",
    "test:host": "node esbuild.js && tsc --project tsconfig.test.json && vscode-test",
    "test": "npm run test:unit",
    "vsix": "vsce package",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "ensemble:release": "npm run release"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.2"
  }
}
