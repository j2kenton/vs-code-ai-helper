          "deprecationMessage": "Use `ensemble.modelSettings` instead.",
          "type": "object",
          "default": {},
          "scope": "window",
          "description": "Primary and backup models per stage, along with fallback strategy. Configure via Ensemble Settings."
        },
        "vs-code-ai-helper.warnings.unsavedSettings": {
          "deprecationMessage": "Use `ensemble.warnings.unsavedSettings` instead.",
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Warn before discarding unsaved changes in the AI Models panel. The warning dialog offers \"Don't show again\", which sets this to false."
        },
        "vs-code-ai-helper.warnings.largeTokenRequest": {
          "deprecationMessage": "Use `ensemble.warnings.largeTokenRequest` instead.",
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Warn before sending a large AI prompt that may use significant quota. The warning dialog offers \"Proceed and don't ask again\", which sets this to false."
