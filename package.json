{
  "name": "vs-code-ai-helper",
  "displayName": "VS Code AI Helper",
  "description": "A VS Code extension for helping developers utilize AI tools and LLMs in their work",
  "version": "0.6.5",
  "publisher": "j2kenton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j2kenton/vs-code-ai-helper.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-code-ai-helper.helloWorld",
        "title": "AI Helper: Hello World"
      },
      {
        "command": "vs-code-ai-helper.selectMetaFolder",
        "title": "AI Helper: Select Meta Resources Folder"
      },
      {
        "command": "vs-code-ai-helper.startNewTask",
        "title": "AI Helper: Start New Task",
        "icon": "$(add)"
      },
      {
        "command": "vs-code-ai-helper.resumeTask",
        "title": "AI Helper: Resume Task",
        "icon": "$(play)"
      },
      {
        "command": "vs-code-ai-helper.generatePlanWithAI",
        "title": "AI Helper: Generate Plan with AI"
      },
      {
        "command": "vs-code-ai-helper.runReviewWithAI",
        "title": "AI Helper: Run Review with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "vs-code-ai-helper.viewReview",
        "title": "AI Helper: View Review",
        "icon": "$(eye)"
      },
      {
        "command": "vs-code-ai-helper.replyToReview",
        "title": "AI Helper: Reply to Review",
        "icon": "$(comment)"
      },
      {
        "command": "vs-code-ai-helper.applyReviewWithAI",
        "title": "AI Helper: Apply Review with AI",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.nextStage",
        "title": "AI Helper: Next Stage",
        "icon": "$(arrow-right)"
      },
      {
        "command": "vs-code-ai-helper.generateImplementationWithAI",
        "title": "AI Helper: Generate Implementation Checklist with AI",
        "icon": "$(tasklist)"
      },
      {
        "command": "vs-code-ai-helper.runImplementationWithAI",
        "title": "AI Helper: Run Implementation with AI",
        "icon": "$(rocket)"
      },
      {
        "command": "vs-code-ai-helper.configureStepModels",
        "title": "AI Helper: Configure AI Models per Step",
        "icon": "$(server-environment)"
      },
      {
        "command": "vs-code-ai-helper.setStageModel",
        "title": "AI Helper: Set Model for This Step",
        "icon": "$(server-environment)"
      },
      {
        "command": "vs-code-ai-helper.setTaskStage",
        "title": "AI Helper: Set Task Stage",
        "icon": "$(milestone)"
      },
      {
        "command": "vs-code-ai-helper.refreshTasksView",
        "title": "AI Helper: Refresh Tasks View",
        "icon": "$(refresh)"
      },
      {
        "command": "vs-code-ai-helper.expandAllTasks",
        "title": "AI Helper: Expand All Steps",
        "icon": "$(expand-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-helper",
          "title": "AI Helper",
          "icon": "images/tasks-view.svg"
        }
      ]
    },
    "views": {
      "ai-helper": [
        {
          "id": "vs-code-ai-helper.tasksView",
          "name": "Tasks",
          "icon": "images/tasks-view.svg",
          "contextualTitle": "AI Helper Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "No meta resources folder is configured yet. Select one to start tracking tasks.\n[Select Meta Resources Folder](command:vs-code-ai-helper.selectMetaFolder)",
        "when": "!vs-code-ai-helper.hasMetaFolder"
      },
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "No tasks yet. Start one to see its workflow progress here.\n[Start New Task](command:vs-code-ai-helper.startNewTask)",
        "when": "vs-code-ai-helper.hasMetaFolder && !vs-code-ai-helper.hasTasks"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vs-code-ai-helper.startNewTask",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@1"
        },
        {
          "command": "vs-code-ai-helper.refreshTasksView",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@2"
        },
        {
          "command": "vs-code-ai-helper.expandAllTasks",
          "when": "view == vs-code-ai-helper.tasksView && vs-code-ai-helper.hasTasks",
          "group": "navigation@3"
        },
        {
          "command": "vs-code-ai-helper.configureStepModels",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "vs-code-ai-helper.resumeTask",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active || viewItem == task-created)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.setTaskStage",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active || viewItem == task-created || viewItem == task-completed)",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.configureStepModels",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active || viewItem == task-created || viewItem == task-completed || viewItem == task-active-review)",
          "group": "task@3"
        },
        {
          "command": "vs-code-ai-helper.runReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-reviewable-current/",
          "group": "inline@3"
        },
        {
          "command": "vs-code-ai-helper.runImplementationWithAI",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == stage-plan-final-current || viewItem =~ /^stage-impl-current/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.runReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-current/",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.viewReview",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active-review || viewItem =~ /^stage-review-current/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.runReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active-review || viewItem =~ /^stage-review-current/)",
          "group": "inline@2.5"
        },
        {
          "command": "vs-code-ai-helper.replyToReview",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active-review || viewItem =~ /^stage-review-current/)",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.applyReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active-review || viewItem =~ /^stage-review-current/)",
          "group": "inline@3"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active-review || viewItem =~ /^stage-review-current/)",
          "group": "inline@4"
        },
        {
          "command": "vs-code-ai-helper.runReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem == task-active-review || viewItem =~ /^stage-review-current/)",
          "group": "review@1"
        },
        {
          "command": "vs-code-ai-helper.resumeTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem == task-active-review",
          "group": "task@1"
        },
        {
          "command": "vs-code-ai-helper.setTaskStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem == task-active-review",
          "group": "task@2"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem == task-active",
          "group": "task@1"
        },
        {
          "command": "vs-code-ai-helper.setTaskStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage(-modelable)?$/",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.setStageModel",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /-modelable$/",
          "group": "inline@9"
        }
      ]
    },
    "configuration": {
      "title": "VS Code AI Helper",
      "properties": {
        "vs-code-ai-helper.metaResourcesPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Workspace folder path for storing meta-level resources (logs, documentation, work tracking)"
        },
        "vs-code-ai-helper.promptDismissed": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "When true, suppresses folder configuration prompts permanently for this workspace"
        },
        "vs-code-ai-helper.aiModelDefaults": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "markdownDescription": "Workspace defaults for Copilot model IDs by AI workflow stage. Configure via **AI Helper: Configure AI Models per Step**.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "vs-code-ai-helper.modelSelectionPromptShown": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Tracks whether first-task model-selection onboarding has already been shown in this workspace"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:unit": "tsc --project tsconfig.test.json && node --test out/test/pathSafety.test.js out/test/implReviewFileSelection.test.js",
    "test": "vscode-test",
    "vsix": "vsce package",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.2"
  }
}
