{
  "name": "vs-code-ai-helper",
  "displayName": "Ensemble",
  "description": "AI-assisted task planning and implementation workflow for VS Code. Uses your existing AI subscriptions (Copilot, Claude, Codex, Gemini, Antigravity, Kiro) — real usage costs apply. AI runs can modify workspace files. Provided as-is with no warranty. See README and DISCLAIMER.md.",
  "version": "0.30.1",
  "publisher": "j2kenton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j2kenton/vs-code-ai-helper.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-code-ai-helper.helloWorld",
        "title": "Hello World",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.selectMetaFolder",
        "title": "Select Meta Resources Folder",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.startNewTask",
        "title": "Start New Task",
        "category": "Ensemble",
        "icon": "$(add)"
      },
      {
        "command": "vs-code-ai-helper.resumeTask",
        "title": "Resume Task",
        "category": "Ensemble",
        "icon": "$(debug-continue)"
      },
      {
        "command": "vs-code-ai-helper.pauseTask",
        "title": "Pause Task",
        "category": "Ensemble",
        "icon": "$(debug-pause)"
      },
      {
        "command": "vs-code-ai-helper.draftTaskWithAI",
        "title": "Draft with AI",
        "category": "Ensemble",
        "icon": "$(sparkle)"
      },
      {
        "command": "vs-code-ai-helper.generatePlanWithAI",
        "title": "Generate Plan",
        "category": "Ensemble",
        "icon": "$(sparkle)"
      },
      {
        "command": "vs-code-ai-helper.runReviewWithAI",
        "title": "Review with AI",
        "category": "Ensemble",
        "icon": "$(law)"
      },
      {
        "command": "vs-code-ai-helper.applyReviewWithAI",
        "title": "Apply Review with AI",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.fastForwardReviewWithAI",
        "title": "Fast Forward Fixes",
        "category": "Ensemble",
        "icon": "$(run-all)"
      },
      {
        "command": "vs-code-ai-helper.nextStage",
        "title": "Complete Stage & Move On",
        "category": "Ensemble",
        "icon": "$(arrow-right)"
      },
      {
        "command": "vs-code-ai-helper.generateImplementationWithAI",
        "title": "Generate Implementation Checklist",
        "category": "Ensemble",
        "icon": "$(tasklist)"
      },
      {
        "command": "vs-code-ai-helper.runImplementationWithAI",
        "title": "Run Implementation",
        "category": "Ensemble",
        "icon": "$(rocket)"
      },
      {
        "command": "vs-code-ai-helper.configureStepModels",
        "title": "Configure Workspace Default Models",
        "category": "Ensemble",
        "icon": "$(server-environment)"
      },
      {
        "command": "vs-code-ai-helper.setTaskStage",
        "title": "Jump to Stage",
        "category": "Ensemble",
        "icon": "$(target)"
      },
      {
        "command": "vs-code-ai-helper.setStageAsCurrent",
        "title": "Set as Current Stage",
        "category": "Ensemble",
        "icon": "$(target)"
      },
      {
        "command": "vs-code-ai-helper.refreshTasksView",
        "title": "Refresh Tasks",
        "category": "Ensemble",
        "icon": "$(refresh)"
      },
      {
        "command": "vs-code-ai-helper.applyCurrentStageAction",
        "title": "Apply Current Stage Action",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.applyHighLevelReviewChanges",
        "title": "Apply High-Level Review",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.applyLowLevelReviewChanges",
        "title": "Apply Low-Level Review",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.commitAndPushTask",
        "title": "Commit and Push",
        "category": "Ensemble",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vs-code-ai-helper.viewDisclaimer",
        "title": "View Disclaimer",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.expandAllTasks",
        "title": "Expand All Tasks",
        "category": "Ensemble",
        "icon": "$(expand-all)"
      },
      {
        "command": "vs-code-ai-helper.collapseAllTasks",
        "title": "Collapse All Tasks",
        "category": "Ensemble",
        "icon": "$(collapse-all)"
      },
      {
        "command": "vs-code-ai-helper.toggleMetaResourcesGitIgnore",
        "title": "Toggle Meta Resources in .gitignore",
        "category": "Ensemble",
        "icon": "$(eye-closed)"
      },
      {
        "command": "vs-code-ai-helper.hideMetaResourcesInGitIgnore",
        "title": "Hide Current Task Meta Files",
        "category": "Ensemble",
        "icon": "$(eye-closed)"
      },
      {
        "command": "vs-code-ai-helper.showMetaResourcesInGitIgnore",
        "title": "Show Current Task Meta Files",
        "category": "Ensemble",
        "icon": "$(eye)"
      },
      {
        "command": "vs-code-ai-helper.chatWithStage",
        "title": "Chat with Stage AI",
        "category": "Ensemble",
        "icon": "$(comment)"
      },
      {
        "command": "vs-code-ai-helper.openGeneralAssistant",
        "title": "Open AI Assistant",
        "category": "Ensemble",
        "icon": "$(robot)"
      },
      {
        "command": "vs-code-ai-helper.runLintingFixes",
        "title": "Linting & Code Errors",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.scheduleTaskResume",
        "title": "Schedule Resume",
        "category": "Ensemble",
        "icon": "$(clock)"
      },
      {
        "command": "vs-code-ai-helper.viewTask",
        "title": "View Task",
        "category": "Ensemble",
        "icon": "$(file-text)"
      },
      {
        "command": "vs-code-ai-helper.viewPlan",
        "title": "View Plan",
        "category": "Ensemble",
        "icon": "$(book)"
      },
      {
        "command": "vs-code-ai-helper.viewReview",
        "title": "View Review",
        "category": "Ensemble",
        "icon": "$(eye)"
      },
      {
        "command": "vs-code-ai-helper.markTaskDone",
        "title": "Complete and Move On to Next Task",
        "category": "Ensemble",
        "icon": "$(check)"
      },
      {
        "command": "vs-code-ai-helper.completeCommitAndPushTask",
        "title": "Commit & Push",
        "category": "Ensemble",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vs-code-ai-helper.release",
        "title": "Release",
        "category": "Ensemble",
        "icon": "$(package)"
      },
      {
        "command": "vs-code-ai-helper.openAndStartNewTask",
        "title": "Open Ensemble and Start New Task",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.reviewCurrentTask",
        "title": "Review with AI",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.fastForwardCurrentTaskReview",
        "title": "Fast Forward Current Task Review",
        "category": "Ensemble"
      }
    ],
    "keybindings": [
      {
        "command": "vs-code-ai-helper.applyCurrentStageAction",
        "key": "ctrl+shift+alt+i",
        "mac": "cmd+shift+alt+i"
      },
      {
        "command": "vs-code-ai-helper.openAndStartNewTask",
        "key": "ctrl+shift+alt+o",
        "mac": "cmd+shift+alt+o"
      },
      {
        "command": "vs-code-ai-helper.reviewCurrentTask",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "vs-code-ai-helper.fastForwardCurrentTaskReview",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-helper",
          "title": "Ensemble",
          "icon": "images/tasks-view.svg"
        }
      ]
    },
    "views": {
      "ai-helper": [
        {
          "id": "vs-code-ai-helper.tasksView",
          "name": "Tasks",
          "icon": "images/tasks-view.svg",
          "contextualTitle": "Ensemble Tasks"
        },
        {
          "id": "vs-code-ai-helper.statusView",
          "name": "Recent Status",
          "icon": "images/tasks-view.svg",
          "contextualTitle": "Ensemble Status"
        },
        {
          "id": "vs-code-ai-helper.settingsView",
          "type": "webview",
          "name": "Settings",
          "icon": "$(gear)",
          "contextualTitle": "Ensemble Settings"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "Loading tasks…",
        "when": "!vs-code-ai-helper.tasksInitialized"
      },
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "No meta resources folder is configured yet. Select one to start tracking tasks.\n[Select Meta Resources Folder](command:vs-code-ai-helper.selectMetaFolder)",
        "when": "vs-code-ai-helper.tasksInitialized && !vs-code-ai-helper.hasMetaFolder"
      },
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "No tasks yet. Start one to see its workflow progress here.\n[Start New Task](command:vs-code-ai-helper.startNewTask)",
        "when": "vs-code-ai-helper.tasksInitialized && vs-code-ai-helper.hasMetaFolder && !vs-code-ai-helper.hasTasks"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vs-code-ai-helper.startNewTask",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@1"
        },
        {
          "command": "vs-code-ai-helper.refreshTasksView",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@2"
        },
        {
          "command": "vs-code-ai-helper.expandAllTasks",
          "when": "view == vs-code-ai-helper.tasksView && vs-code-ai-helper.hasTasks && vs-code-ai-helper.tasksViewAllCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "vs-code-ai-helper.collapseAllTasks",
          "when": "view == vs-code-ai-helper.tasksView && vs-code-ai-helper.hasTasks && !vs-code-ai-helper.tasksViewAllCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "vs-code-ai-helper.configureStepModels",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@4"
        },
        {
          "command": "vs-code-ai-helper.hideMetaResourcesInGitIgnore",
          "when": "view == vs-code-ai-helper.tasksView && !vs-code-ai-helper.currentTaskMetaHidden",
          "group": "navigation@5"
        },
        {
          "command": "vs-code-ai-helper.showMetaResourcesInGitIgnore",
          "when": "view == vs-code-ai-helper.tasksView && vs-code-ai-helper.currentTaskMetaHidden",
          "group": "navigation@5"
        },
        {
          "command": "vs-code-ai-helper.openGeneralAssistant",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "vs-code-ai-helper.resumeTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task-paused/",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.pauseTask",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem =~ /^task-active/ || viewItem =~ /^task-completed/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.setStageAsCurrent",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-desc/ && !(viewItem =~ /-current/) && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.draftTaskWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-desc-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-desc-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@9"
        },
        {
          "command": "vs-code-ai-helper.setStageAsCurrent",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-plan/ && !(viewItem =~ /-current/) && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.generatePlanWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-plan-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-plan-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@9"
        },
        {
          "command": "vs-code-ai-helper.generateImplementationWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.runImplementationWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@9"
        },
        {
          "command": "vs-code-ai-helper.runReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && ((viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)) || (viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)))",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.applyReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && ((viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)) || (viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)))",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.fastForwardReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && ((viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)) || (viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)))",
          "group": "inline@3"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@9"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@9"
        },
        {
          "command": "vs-code-ai-helper.runLintingFixes",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.runReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.chatWithStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.commitAndPushTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@3"
        },
        {
          "command": "vs-code-ai-helper.markTaskDone",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@4"
        },
        {
          "command": "vs-code-ai-helper.release",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@5"
        },
        {
          "command": "vs-code-ai-helper.setStageAsCurrent",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage/ && !(viewItem =~ /^stage-desc/) && !(viewItem =~ /^stage-plan/) && !(viewItem =~ /-current/) && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.chatWithStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /-modelable$/",
          "group": "inline@9"
        },
        {
          "command": "vs-code-ai-helper.scheduleTaskResume",
          "when": "view == vs-code-ai-helper.tasksView && ((viewItem =~ /^task-active/ && !(viewItem =~ /^task-active-review/)) || viewItem =~ /^task-paused/)",
          "group": "task@4"
        }
      ]
    },
    "configuration": {
      "title": "Ensemble",
      "properties": {
        "vs-code-ai-helper.metaResourcesPath": {
          "type": "string",
          "default": ".helper/plans",
          "scope": "resource",
          "description": "Workspace folder path for storing task plans and workflow state. Defaults to .helper/plans."
        },
        "vs-code-ai-helper.promptDismissed": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "When true, suppresses folder configuration prompts permanently for this workspace"
        },
        "vs-code-ai-helper.aiModelDefaults": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "markdownDescription": "Workspace defaults for AI model IDs by workflow stage. Bare IDs are GitHub Copilot models; prefixed IDs (e.g. `claude-cli:sonnet`, `codex-cli:default`, `gemini-cli:gemini-2.5-pro`, `antigravity-cli:default`, `kiro-cli:default`) run through the vendor's subscription CLI. Configure via **Ensemble: Configure AI Models per Step**.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "vs-code-ai-helper.modelSettings": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "Workspace settings for primary and backup models per stage, along with fallback strategy."
        },
        "vs-code-ai-helper.modelSelectionPromptShown": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Tracks whether first-task model-selection onboarding has already been shown in this workspace"
        },
        "vs-code-ai-helper.maxImplementationIterations": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 200,
          "scope": "resource",
          "description": "Maximum Copilot implementation tool-call rounds (1-200)."
        },
        "vs-code-ai-helper.codexDangerouslyBypassSandboxForImplementation": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "When true, Codex implementation runs use `codex exec --dangerously-bypass-approvals-and-sandbox` instead of the `workspace-write` sandbox. This is dangerous because Codex can execute commands without sandboxing. Enable only in trusted workspaces when Codex refuses to edit under `workspace-write`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:unit": "node -e \"require('fs').rmSync('out/test',{recursive:true,force:true})\" && tsc --project tsconfig.test.json && node test-stubs/run-unit-tests.js",
    "test": "vscode-test",
    "vsix": "vsce package",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.2"
  }
}
