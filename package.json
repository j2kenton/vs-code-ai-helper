{
  "name": "vs-code-ai-helper",
  "displayName": "Ensemble",
  "description": "AI-assisted task planning and implementation workflow for VS Code. Uses your existing AI subscriptions (Copilot, Claude, Codex, Gemini, Antigravity, Kiro) — real usage costs apply. AI runs can modify workspace files. Provided as-is with no warranty. See README and DISCLAIMER.md.",
  "version": "0.55.2",
  "publisher": "j2kenton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j2kenton/vs-code-ai-helper.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-code-ai-helper.helloWorld",
        "title": "Hello World",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.migrateMetaResources",
        "title": "Move Ensemble Resources to .ensemble",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.startNewTask",
        "title": "Start New Task",
        "category": "Ensemble",
        "icon": "$(add)"
      },
      {
        "command": "vs-code-ai-helper.resumeTask",
        "title": "Resume Task",
        "category": "Ensemble",
        "icon": "$(debug-continue)"
      },
      {
        "command": "vs-code-ai-helper.pauseTask",
        "title": "Pause Task",
        "category": "Ensemble",
        "icon": "$(debug-pause)"
      },
      {
        "command": "vs-code-ai-helper.draftTaskWithAI",
        "title": "Draft with AI",
        "category": "Ensemble",
        "icon": "$(sparkle)"
      },
      {
        "command": "vs-code-ai-helper.generatePlanWithAI",
        "title": "Generate Plan",
        "category": "Ensemble",
        "icon": "$(sparkle)"
      },
      {
        "command": "vs-code-ai-helper.runReviewWithAI",
        "title": "Review with AI",
        "category": "Ensemble",
        "icon": "$(law)"
      },
      {
        "command": "vs-code-ai-helper.applyReviewWithAI",
        "title": "Apply Review with AI",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.fastForwardReviewWithAI",
        "title": "Fast Forward Fixes",
        "category": "Ensemble",
        "icon": "$(run-all)"
      },
      {
        "command": "vs-code-ai-helper.nextStage",
        "title": "Complete Stage & Move On [Ctrl+Shift+Alt+N]",
        "category": "Ensemble",
        "icon": "$(arrow-right)"
      },
      {
        "command": "vs-code-ai-helper.runImplementationWithAI",
        "title": "Implement Actual Work [Ctrl+Shift+Alt+I]",
        "category": "Ensemble",
        "icon": "$(rocket)"
      },
      {
        "command": "vs-code-ai-helper.setTaskStage",
        "title": "Jump to Stage",
        "category": "Ensemble",
        "icon": "$(target)"
      },
      {
        "command": "vs-code-ai-helper.setStageAsCurrent",
        "title": "Set as Current Stage",
        "category": "Ensemble",
        "icon": "$(target)"
      },
      {
        "command": "vs-code-ai-helper.refreshTasksView",
        "title": "Refresh Tasks",
        "category": "Ensemble",
        "icon": "$(refresh)"
      },
      {
        "command": "vs-code-ai-helper.openSettings",
        "title": "Open Ensemble Settings",
        "category": "Ensemble",
        "icon": "$(gear)"
      },
      {
        "command": "vs-code-ai-helper.openAiModels",
        "title": "Configure AI Models",
        "category": "Ensemble",
        "icon": "$(settings)"
      },
      {
        "command": "vs-code-ai-helper.archiveTask",
        "title": "Archive Task",
        "category": "Ensemble",
        "icon": "$(archive)"
      },
      {
        "command": "vs-code-ai-helper.unarchiveTask",
        "title": "Resume Archived Task",
        "category": "Ensemble",
        "icon": "$(debug-continue)"
      },
      {
        "command": "vs-code-ai-helper.pinTask",
        "title": "Pin Task",
        "category": "Ensemble",
        "icon": "$(pin)"
      },
      {
        "command": "vs-code-ai-helper.unpinTask",
        "title": "Unpin Task",
        "category": "Ensemble",
        "icon": "$(pinned)"
      },
      {
        "command": "vs-code-ai-helper.filterNotifications",
        "title": "Filter Notifications by Type",
        "category": "Ensemble",
        "icon": "$(filter)"
      },
      {
        "command": "vs-code-ai-helper.chooseReleaseTarget",
        "title": "Choose Release Target (package.json)",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.choosePublishScope",
        "title": "Choose Publish Verification Scope",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.filterTasksByStatus",
        "title": "Filter Tasks by Status",
        "category": "Ensemble",
        "icon": "$(filter)"
      },
      {
        "command": "vs-code-ai-helper.resetTaskStatusFilter",
        "title": "Reset Task Status Filter",
        "category": "Ensemble",
        "icon": "$(clear-all)"
      },
      {
        "command": "vs-code-ai-helper.clearNotifications",
        "title": "Clear All Notifications",
        "category": "Ensemble",
        "icon": "$(clear-all)"
      },
      {
        "command": "vs-code-ai-helper.cancelOperation",
        "title": "Cancel Operation",
        "category": "Ensemble",
        "icon": "$(stop-circle)"
      },
      {
        "command": "vs-code-ai-helper.applyCurrentStageAction",
        "title": "Apply Current Stage Action [Ctrl+Shift+Alt+I]",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.applyHighLevelReviewChanges",
        "title": "Apply High-Level Review",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.applyLowLevelReviewChanges",
        "title": "Apply Low-Level Review",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.commitAndPushTask",
        "title": "Commit and Push [Ctrl+Shift+Alt+P]",
        "category": "Ensemble",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vs-code-ai-helper.viewDisclaimer",
        "title": "View Disclaimer",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.expandAllTasks",
        "title": "Expand All Tasks",
        "category": "Ensemble",
        "icon": "$(expand-all)"
      },
      {
        "command": "vs-code-ai-helper.collapseAllTasks",
        "title": "Collapse All Tasks",
        "category": "Ensemble",
        "icon": "$(collapse-all)"
      },
      {
        "command": "vs-code-ai-helper.chatWithStage",
        "title": "Respond to AI",
        "category": "Ensemble",
        "icon": "$(comment)"
      },
      {
        "command": "vs-code-ai-helper.postStageQuestion",
        "title": "Post Stage AI Question",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.openGeneralAssistant",
        "title": "Open AI Assistant",
        "category": "Ensemble",
        "icon": "$(robot)"
      },
      {
        "command": "vs-code-ai-helper.runPublishChecks",
        "title": "Run Publish Checks (Lint, Tests & Plan)",
        "category": "Ensemble",
        "icon": "$(law)"
      },
      {
        "command": "vs-code-ai-helper.runLintingFixes",
        "title": "Fix Linting & Code Errors",
        "category": "Ensemble",
        "icon": "$(wand)"
      },
      {
        "command": "vs-code-ai-helper.scheduleTaskResume",
        "title": "Schedule Current Stage Action",
        "category": "Ensemble",
        "icon": "$(clock)"
      },
      {
        "command": "vs-code-ai-helper.cancelScheduledTaskAction",
        "title": "Cancel Scheduled Stage Action",
        "category": "Ensemble",
        "icon": "$(clock)"
      },
      {
        "command": "vs-code-ai-helper.viewTask",
        "title": "View Task",
        "category": "Ensemble",
        "icon": "$(file-text)"
      },
      {
        "command": "vs-code-ai-helper.viewPlan",
        "title": "View Plan",
        "category": "Ensemble",
        "icon": "$(book)"
      },
      {
        "command": "vs-code-ai-helper.viewReview",
        "title": "View Review",
        "category": "Ensemble",
        "icon": "$(eye)"
      },
      {
        "command": "vs-code-ai-helper.markTaskDone",
        "title": "Complete Task",
        "category": "Ensemble",
        "icon": "$(check)"
      },
      {
        "command": "vs-code-ai-helper.completeCommitAndPushTask",
        "title": "Commit & Push",
        "category": "Ensemble",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vs-code-ai-helper.release",
        "title": "Release",
        "category": "Ensemble",
        "icon": "$(package)"
      },
      {
        "command": "vs-code-ai-helper.openAndStartNewTask",
        "title": "Open Ensemble and Start New Task [Ctrl+Shift+Alt+O]",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.reviewCurrentTask",
        "title": "Review with AI [Ctrl+Shift+Alt+R]",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.fastForwardCurrentTaskReview",
        "title": "Fast Forward Current Task Review [Ctrl+Shift+Alt+F]",
        "category": "Ensemble"
      },
      {
        "command": "vs-code-ai-helper.viewStageChanges",
        "title": "View Changes",
        "category": "Ensemble",
        "icon": "$(diff)"
      },
      {
        "command": "vs-code-ai-helper.revertStageChanges",
        "title": "Revert Changes",
        "category": "Ensemble",
        "icon": "$(discard)"
      },
      {
        "command": "vs-code-ai-helper.deleteStageBackup",
        "title": "Delete Previous Version",
        "category": "Ensemble",
        "icon": "$(trash)"
      },
      {
        "command": "vs-code-ai-helper.renameTask",
        "title": "Rename Task",
        "category": "Ensemble",
        "icon": "$(edit)"
      },
      {
        "command": "vs-code-ai-helper.renameTaskWithAI",
        "title": "Rename Task with AI",
        "category": "Ensemble",
        "icon": "$(sparkle)"
      },
      {
        "command": "vs-code-ai-helper.confirmCommitMessage",
        "title": "Confirm Commit Message",
        "category": "Ensemble",
        "icon": "$(git-commit)"
      }
    ],
    "keybindings": [
      {
        "command": "vs-code-ai-helper.applyCurrentStageAction",
        "key": "ctrl+shift+alt+i",
        "mac": "cmd+shift+alt+i",
        "when": "vs-code-ai-helper.tasksInitialized"
      },
      {
        "command": "vs-code-ai-helper.openAndStartNewTask",
        "key": "ctrl+shift+alt+o",
        "mac": "cmd+shift+alt+o"
      },
      {
        "command": "vs-code-ai-helper.reviewCurrentTask",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "vs-code-ai-helper.fastForwardCurrentTaskReview",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f"
      },
      {
        "command": "vs-code-ai-helper.commitAndPushTask",
        "key": "ctrl+shift+alt+p",
        "mac": "cmd+shift+alt+p"
      },
      {
        "command": "vs-code-ai-helper.nextStage",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-helper",
          "title": "Ensemble",
          "icon": "images/tasks-view.svg"
        }
      ]
    },
    "views": {
      "ai-helper": [
        {
          "id": "vs-code-ai-helper.tasksView",
          "name": "Tasks",
          "icon": "images/tasks-view.svg",
          "contextualTitle": "Ensemble Tasks"
        },
        {
          "id": "vs-code-ai-helper.statusView",
          "name": "Notifications",
          "icon": "images/tasks-view.svg",
          "contextualTitle": "Ensemble Status"
        },
        {
          "id": "vs-code-ai-helper.chatView",
          "type": "webview",
          "name": "Chat With AI",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Ensemble Chat With AI"
        },
        {
          "id": "vs-code-ai-helper.settingsView",
          "type": "webview",
          "name": "AI Models",
          "icon": "$(gear)",
          "contextualTitle": "Ensemble AI Models"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "Loading tasks…",
        "when": "!vs-code-ai-helper.tasksInitialized"
      },
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "Open a workspace folder to start tracking tasks. Ensemble stores task metadata in `.ensemble`.\n[Start New Task](command:vs-code-ai-helper.startNewTask)",
        "when": "vs-code-ai-helper.tasksInitialized && !vs-code-ai-helper.hasMetaFolder"
      },
      {
        "view": "vs-code-ai-helper.tasksView",
        "contents": "No tasks yet. Start one to see its workflow progress here.\n[Start New Task](command:vs-code-ai-helper.startNewTask)",
        "when": "vs-code-ai-helper.tasksInitialized && vs-code-ai-helper.hasMetaFolder && !vs-code-ai-helper.hasTasks"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vs-code-ai-helper.confirmCommitMessage",
          "when": "resourceScheme == untitled && resourceLangId == git-commit && resourceFilename in vs-code-ai-helper.pendingCommitFilenames",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "vs-code-ai-helper.startNewTask",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@1"
        },
        {
          "command": "vs-code-ai-helper.refreshTasksView",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@2"
        },
        {
          "command": "vs-code-ai-helper.openGeneralAssistant",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@6"
        },
        {
          "command": "vs-code-ai-helper.filterTasksByStatus",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@3"
        },
        {
          "command": "vs-code-ai-helper.expandAllTasks",
          "when": "view == vs-code-ai-helper.tasksView && !vs-code-ai-helper.taskListAllExpanded",
          "group": "navigation@4"
        },
        {
          "command": "vs-code-ai-helper.collapseAllTasks",
          "when": "view == vs-code-ai-helper.tasksView && vs-code-ai-helper.taskListAllExpanded",
          "group": "navigation@4"
        },
        {
          "command": "vs-code-ai-helper.openSettings",
          "when": "view == vs-code-ai-helper.tasksView",
          "group": "navigation@9"
        },
        {
          "command": "vs-code-ai-helper.filterNotifications",
          "when": "view == vs-code-ai-helper.statusView",
          "group": "navigation@1"
        },
        {
          "command": "vs-code-ai-helper.clearNotifications",
          "when": "view == vs-code-ai-helper.statusView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vs-code-ai-helper.cancelOperation",
          "when": "view == vs-code-ai-helper.statusView && viewItem == ensemble-operation-cancellable",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.resumeTask",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem =~ /^task-paused/ || viewItem =~ /^task-completed/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.pauseTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task-active/",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.unarchiveTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task-archived/",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.archiveTask",
          "when": "view == vs-code-ai-helper.tasksView && (viewItem =~ /^task-active/ || viewItem =~ /^task-paused/ || viewItem =~ /^task-completed/)",
          "group": "inline@4"
        },
        {
          "command": "vs-code-ai-helper.pinTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task/ && !(viewItem =~ /-pinned$/) && !(viewItem =~ /^task-archived/)",
          "group": "inline@90"
        },
        {
          "command": "vs-code-ai-helper.unpinTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task/ && viewItem =~ /-pinned$/",
          "group": "inline@90"
        },
        {
          "command": "vs-code-ai-helper.setStageAsCurrent",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-desc/ && !(viewItem =~ /-current/) && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.draftTaskWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-desc-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-desc-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@99"
        },
        {
          "command": "vs-code-ai-helper.setStageAsCurrent",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-plan/ && !(viewItem =~ /-current/) && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.generatePlanWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-plan-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-plan-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@99"
        },
        {
          "command": "vs-code-ai-helper.runImplementationWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@99"
        },
        {
          "command": "vs-code-ai-helper.runReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && ((viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)) || (viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)))",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.applyReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && ((viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)) || (viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)))",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.fastForwardReviewWithAI",
          "when": "view == vs-code-ai-helper.tasksView && ((viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)) || (viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)))",
          "group": "inline@3"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-review-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@99"
        },
        {
          "command": "vs-code-ai-helper.nextStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-impl-low-review-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@99"
        },
        {
          "command": "vs-code-ai-helper.runPublishChecks",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@10"
        },
        {
          "command": "vs-code-ai-helper.runLintingFixes",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@20"
        },
        {
          "command": "vs-code-ai-helper.viewStageChanges",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@30"
        },
        {
          "command": "vs-code-ai-helper.revertStageChanges",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && viewItem =~ /-has-backup/ && !(viewItem =~ /-paused/)",
          "group": "inline@35"
        },
        {
          "command": "vs-code-ai-helper.chatWithStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@40"
        },
        {
          "command": "vs-code-ai-helper.commitAndPushTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@50"
        },
        {
          "command": "vs-code-ai-helper.release",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@60"
        },
        {
          "command": "vs-code-ai-helper.markTaskDone",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage-publish-current/ && !(viewItem =~ /-paused/)",
          "group": "inline@70"
        },
        {
          "command": "vs-code-ai-helper.setStageAsCurrent",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage/ && !(viewItem =~ /^stage-desc/) && !(viewItem =~ /^stage-plan/) && !(viewItem =~ /-current/) && !(viewItem =~ /-paused/)",
          "group": "inline@1"
        },
        {
          "command": "vs-code-ai-helper.chatWithStage",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /-modelable$/ && !(viewItem =~ /^stage-publish-current/) && !(viewItem =~ /-paused/)",
          "group": "inline@7"
        },
        {
          "command": "vs-code-ai-helper.viewStageChanges",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage/ && !(viewItem =~ /^stage-publish-current/)",
          "group": "inline@8"
        },
        {
          "command": "vs-code-ai-helper.revertStageChanges",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage/ && viewItem =~ /-has-backup/ && !(viewItem =~ /^stage-publish-current/)",
          "group": "inline@9"
        },
        {
          "command": "vs-code-ai-helper.deleteStageBackup",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^stage/ && viewItem =~ /-has-backup/",
          "group": "stage@1"
        },
        {
          "command": "vs-code-ai-helper.renameTask",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task/",
          "group": "inline@2"
        },
        {
          "command": "vs-code-ai-helper.renameTaskWithAI",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task/",
          "group": "inline@3"
        },
        {
          "command": "vs-code-ai-helper.scheduleTaskResume",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task-active/ && !(viewItem =~ /-scheduled/)",
          "group": "task@4"
        },
        {
          "command": "vs-code-ai-helper.cancelScheduledTaskAction",
          "when": "view == vs-code-ai-helper.tasksView && viewItem =~ /^task/ && viewItem =~ /-scheduled/",
          "group": "task@4"
        }
      ]
    },
    "configuration": {
      "title": "Ensemble",
