        "vs-code-ai-helper.completeAndMoveOnTriggersAI": {
          "deprecationMessage": "Use `ensemble.completeAndMoveOnTriggersAI` instead.",
          "type": [
            "string",
            "boolean"
          ],
          "enum": [
            "off",
            "auto",
            "auto-fast-forward",
            false,
            true
          ],
          "enumDescriptions": [
