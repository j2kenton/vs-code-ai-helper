# Mobile/web app configuration. Copy to .env.local (gitignored) and fill in.
#
#   cp .env.local.example .env.local
#
# Expo reads .env.local from this directory automatically and inlines every
# EXPO_PUBLIC_* value at build time, so `pnpm --filter @ensemble/mobile web`
# needs no exported variables.
#
# Client IDS ONLY. These ship inside the bundle and are public by design — they
# travel in the authorize URL the browser sees. The matching client SECRETS
# belong to the control plane, which performs the code exchange; a secret here
# would be handed to every visitor.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
