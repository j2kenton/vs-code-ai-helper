{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow-route-removal-v1.schema.json",
  "title": "Workflow route removals (plan §1.2/§1.5)",
  "description": "Shape of workflow-route-removals-v1.json. A removed route requires source evidence, rationale, and a verifier that fails if it returns — scripts/verifyWorkflowRoutes.mjs re-fails any removal whose commandId reappears in the live registration scan.",
  "type": "object",
  "required": ["schemaVersion", "description", "removals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "removals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["commandId", "rationale", "removedInCohort", "sourceEvidence"],
        "properties": {
          "commandId": { "type": "string", "pattern": "^vs-code-ai-helper\\." },
          "path": { "type": "string" },
          "rationale": { "type": "string", "minLength": 1 },
          "removedInCohort": { "type": "string", "minLength": 1 },
          "sourceEvidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
