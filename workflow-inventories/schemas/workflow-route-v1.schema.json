{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow-route-v1.schema.json",
  "title": "Workflow route inventory (plan §1.2)",
  "description": "Shape of workflow-route-baseline-v1.json. One classified row per concrete route: registered commands, webview message roots, internal executeCommand edges (edgeRole-classified), provider-boundary call sites, and legacy output destinations (artifactClass-classified provider-to-writer edges). Mechanical fields are regenerated by scripts/generateWorkflowRoutes.mjs over the exact §1.1 source universe and diffed against the live scan; classification fields are human-authored. The immutable pre-gate reference is workflow-route-pregate-v1.json. Enforcement lives in the generator/verifier (which also proves gate placement, pre-gate drift accounting, and required-target coverage beyond what a JSON schema can express).",
  "type": "object",
  "required": ["schemaVersion", "description", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "span", "targetActionKey", "gateLocation", "migrationCohort"],
        "properties": {
          "kind": { "enum": ["command", "webviewMessage", "internalEdge", "providerEdge", "writerEdge"] },
          "commandId": { "type": "string", "pattern": "^vs-code-ai-helper\\." },
          "path": { "type": "string", "pattern": "^src/" },
          "span": { "type": "string", "pattern": "^L[0-9]+-L[0-9]+$" },
          "registrationSymbol": { "type": "string", "minLength": 1 },
          "handlerSymbol": { "type": "string", "minLength": 1 },
          "enclosingSymbol": { "type": "string", "minLength": 1 },
          "occurrence": { "type": "integer", "minimum": 1 },
          "callee": { "enum": ["resolveRunnerForModel", "runImplementationForModel"] },
          "propertyName": { "enum": ["outputFile", "outputFileUri"] },
          "contributed": { "type": "boolean" },
          "keybound": { "type": "boolean" },
          "menus": { "type": "array", "items": { "type": "string" } },
          "treeBindings": { "type": "array", "items": { "type": "string" } },
          "fileGateRouteIds": { "type": "array", "items": { "type": "string" } },
          "fileEdgesOut": { "type": "array", "items": { "type": "string" } },
          "entrypoint": { "type": "string", "minLength": 1 },
          "earliestRead": { "type": "string", "minLength": 1 },
          "providerEdge": { "type": "string", "minLength": 1 },
          "writerEdge": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "edgeRole": {
            "enum": ["scheduler", "autoAdvance", "followUp", "wrapperDelegation", "uiNavigation", "userPromptAction", "recovery"]
          },
          "artifactClass": {
            "enum": ["taskArtifact", "runsLog", "stagedTemp", "resultEcho", "globalStorage"]
          },
          "targetActionKey": {
            "type": "string",
            "pattern": "^(none|[a-z][A-Za-z0-9]*\\.v1)$"
          },
          "gateLocation": { "type": "string", "minLength": 1 },
          "migrationCohort": {
            "enum": [
              "baseline", "safety", "lmIsolation", "runnerV1", "foundations", "privacy",
              "chat", "text1", "text2", "text3", "lifecycle", "creation", "resume",
              "edit", "git", "cleanup", "nonPlan"
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "command" } } },
            "then": {
              "required": [
                "commandId", "registrationSymbol", "contributed", "keybound", "menus", "treeBindings",
                "fileGateRouteIds", "fileEdgesOut", "entrypoint", "earliestRead", "providerEdge", "writerEdge"
              ]
            }
          },
          {
            "if": { "properties": { "kind": { "const": "webviewMessage" } } },
            "then": {
              "required": ["handlerSymbol", "fileGateRouteIds", "fileEdgesOut", "entrypoint", "earliestRead", "providerEdge", "writerEdge"]
            }
          },
          {
            "if": { "properties": { "kind": { "const": "internalEdge" } } },
            "then": { "required": ["commandId", "enclosingSymbol", "occurrence", "edgeRole", "description"] }
          },
          {
            "if": { "properties": { "kind": { "const": "providerEdge" } } },
            "then": { "required": ["callee", "enclosingSymbol", "occurrence", "description"] }
          },
          {
            "if": { "properties": { "kind": { "const": "writerEdge" } } },
            "then": { "required": ["propertyName", "enclosingSymbol", "occurrence", "artifactClass", "description"] }
          }
        ]
      }
    }
  }
}
