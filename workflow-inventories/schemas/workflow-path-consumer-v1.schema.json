{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow-path-consumer-v1.schema.json",
  "title": "Non-AI path-consumer inventory (plan §2.3)",
  "description": "Shape of workflow-path-consumer-baseline-v1.json. The mechanical columns (`signals` and per-call-site `callSites`, each with a compiler-derived span and enclosing symbol) are regenerated by scripts/generateWorkflowPathConsumers.mjs over the exact §1.1 production source universe and diffed against the live scan; the classification columns are human-authored. The immutable pre-gate reference is workflow-path-consumer-pregate-v1.json; drift from it, and every child_process consumer, requires an annotation in workflow-path-consumer-annotations-v1.json. classifierCall records the row's call into the shared privacy classifier (src/services/workflowPrivacyClassifierV1.ts, plan §2.2); a row still awaiting its own migration cohort may carry a \"pending:privacy — …\" marker until that cohort wires the recorded call. Every other column must be assigned.",
  "type": "object",
  "required": ["schemaVersion", "description", "consumers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "signals", "callSites", "sinkCategories", "pathSource", "expectedHandling", "classifierCall", "migrationCohort"],
        "properties": {
          "path": { "type": "string", "pattern": "^src/" },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["import:fs", "import:child_process", "workspace.fs"] }
          },
          "callSites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["signal", "span", "enclosingSymbol"],
              "properties": {
                "signal": { "enum": ["import:fs", "import:child_process", "workspace.fs"] },
                "span": { "type": "string", "pattern": "^L[0-9]+-L[0-9]+$" },
                "enclosingSymbol": { "type": "string", "minLength": 1 }
              }
            }
          },
          "sinkCategories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "contextPack", "taskScan", "backupCopy", "logAttachment", "gitStaging",
                "folderEnumeration", "providerPromptAttachment", "artifactReadWrite",
                "stateStore", "processSpawn", "diagnostics", "uiNavigation"
              ]
            }
          },
          "pathSource": { "type": "string", "minLength": 1 },
          "expectedHandling": { "type": "string", "minLength": 1 },
          "classifierCall": { "type": "string", "minLength": 1 },
          "migrationCohort": {
            "enum": [
              "baseline", "safety", "lmIsolation", "runnerV1", "foundations", "privacy",
              "chat", "text1", "text2", "text3", "lifecycle", "creation", "resume",
              "edit", "git", "cleanup", "nonPlan"
            ]
          }
        }
      }
    }
  }
}
