{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow-path-consumer-annotation-v1.schema.json",
  "title": "Non-AI path-consumer annotations (plan §2.3/§1.5)",
  "description": "Shape of workflow-path-consumer-annotations-v1.json. Two annotation families, each carrying the §1.5 evidence set: (1) dynamicPathConsumption — required for every production consumer importing child_process (a spawned process consumes paths the scanner cannot resolve; unresolved dynamic path consumption fails verification without recorded evidence), with evidence.sourceSpan matching a live child_process call site; (2) pregateAddedConsumer / pregateRemovedConsumer / pregateModifiedConsumer — required for every consumer added, removed, or whose per-signal call-site profile changed since the immutable pre-gate snapshot (workflow-path-consumer-pregate-v1.json), with stability digests matching the currently computed span-independent projections.",
  "type": "object",
  "required": ["schemaVersion", "description", "annotations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["annotationKind", "path", "planSection", "rationale", "owner", "cohort", "expiryCohort", "evidence"],
        "properties": {
          "annotationKind": {
            "enum": ["dynamicPathConsumption", "pregateAddedConsumer", "pregateRemovedConsumer", "pregateModifiedConsumer"]
          },
          "path": { "type": "string", "pattern": "^src/" },
          "planSection": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "cohort": { "type": "string", "minLength": 1 },
          "expiryCohort": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "required": ["symbol", "sourceSpan", "edgeKind", "targetActionKey"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "sourceSpan": { "type": "string", "pattern": "^L[0-9]+-L[0-9]+$" },
              "edgeKind": { "type": "string", "minLength": 1, "not": { "const": "gateReplacement" } },
              "targetActionKey": { "type": "string", "minLength": 1 },
              "liveStabilitySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "pregateStabilitySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "annotationKind": { "const": "pregateAddedConsumer" } } },
            "then": { "properties": { "evidence": { "required": ["liveStabilitySha256"] } } }
          },
          {
            "if": { "properties": { "annotationKind": { "const": "pregateRemovedConsumer" } } },
            "then": { "properties": { "evidence": { "required": ["pregateStabilitySha256"] } } }
          },
          {
            "if": { "properties": { "annotationKind": { "const": "pregateModifiedConsumer" } } },
            "then": { "properties": { "evidence": { "required": ["liveStabilitySha256", "pregateStabilitySha256"] } } }
          }
        ]
      }
    }
  }
}
