# Control-plane configuration. Copy to .env.local (gitignored) and fill in.
#
#   cp .env.local.example .env.local
#
# `pnpm --filter @ensemble/control-plane serve` loads .env.local automatically,
# so the terminal needs no exported variables.

# The key your stored API keys are encrypted under. ANY long random string
# works, but it must stay THE SAME across restarts: change it and every key
# sealed under the old value becomes permanently unreadable. That failure is
# quiet — the keys still list with their masked hints, and only fail when a
# task tries to use one. Keep this somewhere durable; it cannot be regenerated
# from anything else.
ENSEMBLE_KEK_SECRET=

# OAuth credentials. The SECRETS live here and only here — the app never sees
# them; it holds only the client ids, which are public by construction.
ENSEMBLE_GITHUB_CLIENT_ID=
ENSEMBLE_GITHUB_CLIENT_SECRET=
ENSEMBLE_GOOGLE_CLIENT_ID=
ENSEMBLE_GOOGLE_CLIENT_SECRET=

# Optional. Defaults shown.
# ENSEMBLE_PORT=8787
# ENSEMBLE_DATABASE_PATH=control-plane.sqlite
# ENSEMBLE_CORS_ORIGINS=http://localhost:8081
