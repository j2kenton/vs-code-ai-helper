# Dependencies
node_modules/

# Build output
dist/
out/
out-test/
# Sanctioned scratch compile output (wf10 item 10): a one-off `tsc --outDir`
# during an implementation round belongs here, never in a made-up path like
# .test-out/ — see resources/prompts/run-implementation.md.
.scratch/
# Not a project output path — no tsconfig or npm script emits here. An
# agentic run compiled the tree with a custom --outDir on 2026-08-23 and left
# 12.6MB behind, untracked and unignored, where a `git add -A` would have
# swept it into a commit. Same class as the /implementation.md and
# /plan-final.md entries below: a stray write from a CLI run inventing a path
# outside the project's vocabulary. The real output dirs are dist/ and out/.
.test-out/
*.vsix

# Logs
*.log
npm-debug.log*

# Local planning artifacts
plans/
notes/

# Stray implementation-run artifacts: these filenames are only ever valid
# inside a plans/<task>/ folder. A file with either name at the repo root is
# always a misdirected write from an agentic CLI run, never an intentional doc.
/implementation.md
/plan-final.md

# IDE
.idea/
*.swp
*.swo
.vscode/settings.json

# Claude Code local settings (machine-specific permissions/paths)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Playwright test artifacts
test-results/
playwright-report/

# Downloaded VS Code builds + user data for extension-host tests (test:host)
.vscode-test/

# Environment files
.env
.env.local
.env.*.local

# BEGIN Ensemble managed meta resources
# Managed by Ensemble. Do not edit this block manually.
/artifacts/helper/
/.ensemble/
/.ensemble/**/chat-v1.json
/.ensemble/**/chat-v1.corrupt.json
# END Ensemble managed meta resources

# Ensemble session lock files (transient, machine/pid-specific)
/.ensemble-session.lock
/.helper/

# Local control-plane state. Holds session token hashes and key material
# sealed under the KEK boot secret — never commit it, and note that it is
# only readable by whoever holds that same secret.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Expo's local dev cache.
.expo/

# Local secrets for the control plane and app. The committed .env.local.example
# files document what belongs in each; the real values never leave the machine.
.env.local
.env*.local
